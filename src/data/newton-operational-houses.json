      "entries": {
        "E14": [
          {
            "text": "The state of being either stationary or moving along a "
          },
          {
            "headword": "straight-line",
            "text": "straight-line",
            "self": false
          },
          {
            "text": " with constant "
          },
          {
            "headword": "speed",
            "text": "speed",
            "self": false
          },
          {
            "text": ". Equivalently, a "
          },
          {
            "headword": "point-particle",
            "text": "point-particle",
            "self": false
          },
          {
            "text": " is in "
          },
          {
            "headword": "uniform-motion",
            "text": "uniform-motion",
            "self": true
          },
          {
            "text": " on an interval I if its "
          },
          {
            "headword": "velocity",
            "text": "velocity",
            "self": false
          },
          {
            "text": " is constant throughout I; i.e. for all t1, t2 in I, v(t1) = v(t2). A "
          },
          {
            "headword": "point-particle",
            "text": "point-particle",
            "self": false
          },
          {
            "text": " is in "
          },
          {
            "headword": "uniform-motion",
            "text": "uniform-motion",
            "self": true
          },
          {
            "text": " at "
          },
          {
            "headword": "time",
            "text": "time",
            "self": false
          },
          {
            "text": " t0 if there exists epsilon > 0 such that it is in "
          },
          {
            "headword": "uniform-motion",
            "text": "uniform-motion",
            "self": true
          },
          {
            "text": " on (t0 - epsilon, t0 + epsilon)."
          }
        ],
        "E15": [
          {
            "text": "The state of motion exhibited by a "
